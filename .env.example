DISCORD_TOKEN=你的_DISCORD_BOT_TOKEN

# ---- LM Studio ----
LMSTUDIO_BASE_URL=http://127.0.0.1:8001/v1
# 正式環境用的模型（跟程式預設一樣）；設成空的（LLM_MODEL=）＝自動用 LM Studio 目前載入的第一個聊天模型
LLM_MODEL=swift-1.5-qwen3.8-27b-uncensored-dynamic-mtp@iq4_xs
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=180
# MTP / speculative decoding 模型同時收到多個請求會出錯，保持 1
LLM_MAX_CONCURRENCY=1
# 推理模型想太久會很慢：none / low / medium / high，留空不送
# 聊天回覆建議 none：實測 0.3～2 秒、不會出現空白回覆
LLM_REASONING_EFFORT=none
LLM_JSON_REASONING_EFFORT=low

# HuggingFace 模型快取位置（語音辨識 Qwen3-ASR 從這裡載入）；不設就用預設位置
# HF_HOME=D:\huggingface

# ---- 對話 ----
BOT_NAME=Yuki
WAKE_WORDS=yuki
# 注意模式中跟她說這些（整句就是這個字）她就離開
EXIT_WORDS=掰掰,再見,退下,去睡覺,閉嘴
ATTENTION_TIMEOUT=180
HISTORY_MESSAGES=20

# ---- 人物檔案（python -m scripts.build_profiles all 產生）----
PROFILE_ENABLED=true
PROFILE_DIR=data/profiles
PROFILE_DB_PATH=data/profiles.db
PROFILE_MAX_PEOPLE=4
PROFILE_PROMPT_CHARS=1500
# 建檔：32k 上下文的模型每段 9000 字左右剛好
PROFILE_SEGMENT_CHARS=9000
PROFILE_MAX_CHARS=2500
# 這顆模型開推理（low）會把 token 全花在思考上、很慢；none 一段約 10～25 秒
PROFILE_REASONING_EFFORT=none
# 人物檔案自動增量更新：所有頻道閒置 N 分鐘、封存區新訊息滿 N 則才跑，有人講話就停
PROFILE_AUTO_UPDATE=true
PROFILE_IDLE_MINUTES=5
PROFILE_MIN_NEW=200

# ---- 上網（自架 SearXNG：docker compose -f searxng/docker-compose.yml up -d）----
WEB_ENABLED=true
SEARXNG_URL=http://127.0.0.1:8888
# 一次回覆最多幾輪工具呼叫；每個工具結果最多給模型看幾個字
WEB_MAX_ROUNDS=3
WEB_RESULT_CHARS=5000

# ---- 啟動補抓：每次上線先補齊上次關機到現在的訊息（封存區＋對話紀錄）----
CATCHUP_ENABLED=true
# 「公開頻道」= 這個身分組看得到的頻道，跟 archive_fetch --role 一樣；留空 = @everyone
ARCHIVE_ROLE=
# 不收的頻道名稱，逗號分隔
ARCHIVE_EXCLUDE=

# 舊版 RAG 的記憶庫：已不再讀寫，只有 /不要記我 會刪裡面那個人的舊記憶
DB_PATH=data/yuki.db
LOG_LEVEL=INFO

# ---- 查群組的事（開發規格 6.4）：Yuki 自己用工具查封存區 ----
# 語音一次回覆最多幾輪工具呼叫
VOICE_MAX_ROUNDS=1

# ---- /不要記我（D-28：暫時停用）----
# false＝不註冊 /不要記我、不查退出名單、不擋名字；程式和資料都留著，改成 true 就恢復
OPTOUT_ENABLED=false

# ---- 主人：他交代的事比較會照做，但聊天不偏袒他（Discord user ID，逗號分隔）----
OWNER_USER_IDS=

# ---- 測試伺服器（開發規格 6.0）：不封存、不整理記憶，人物檔案和聊天紀錄借主伺服器的 ----
TEST_GUILD_IDS=
PROFILE_FALLBACK_GUILD=

# ---- 語音對話（開發規格 6.0）----
VOICE_ENABLED=true
VOICE_GUILD_IDS=
# 只聽這些 user ID；其他人的聲音直接丟掉
VOICE_LISTEN_USERS=
# 轉出的文字和 Yuki 的回覆貼到這個文字頻道（除錯用，可留空）
VOICE_LOG_CHANNEL=
VOICE_ASR_MODEL=Qwen/Qwen3-ASR-1.7B
VOICE_ASR_HOTWORDS=LoL,ADC,打野,開黑,Luna,Jinx,Ezreal,patch,system prompt,TTS,ASR,AI,Discord,語音辨識
# breezy（WSL 裡的 scripts/breezy_server.py，連不上會自動改用 Edge）或 edge（線上、免安裝）
VOICE_TTS=breezy
VOICE_TTS_VOICE=zh-TW-HsiaoChenNeural
VOICE_TTS_URL=http://127.0.0.1:8890
VOICE_SILENCE_MS=900
VOICE_ALONE_LEAVE_SECONDS=120
VOICE_ATTENTION_SECONDS=60

# ---- 維運（開發規格 6.12）：AI 追蹤紀錄寫在 data/logs/ai/；出錯時私訊 OWNER_USER_IDS 的人 ----
TRACE_MAX_DAYS=14
TRACE_MAX_MB=200
# 同一種錯誤幾分鐘內只通知一次、全部加起來每小時最多幾則、LM Studio 健康檢查間隔（秒）
ALERT_DEDUPE_MIN=30
ALERT_MAX_PER_HOUR=10
ALERT_HEALTH_SEC=60

# ---- 看圖片（開發規格 6.9）：只看 Discord CDN 的圖片，縮成 JPEG 後附進對話，不存檔 ----
VISION_ENABLED=true
VISION_REPLY_LONG_SIDE=1280
VISION_GLANCE_LONG_SIDE=512
VISION_MAX_IMAGES=5
VISION_RECENT_LINES=10
VISION_MAX_MB=10

# ---- 防洗版與節流（開發規格 6.2）----
# 回完後同頻道幾秒內不主動插話（被叫不受限）
THROTTLE_COOLDOWN_SEC=5
# 同一人 60 秒內叫她超過 3 次：第 4 次起不回，這個人冷卻 120 秒（D-24）
THROTTLE_TAG_LIMIT=3
THROTTLE_TAG_WINDOW_SEC=60
THROTTLE_TAG_COOLDOWN_SEC=120
# 熱鬧模式：60 秒內頻道被叫 ≥ 4 次 → 120 秒內被叫的先收集起來，離上次回覆滿 90 秒合成一次回
CHANNEL_CALL_BURST=4
CHANNEL_CALL_WINDOW_SEC=60
CHANNEL_BURST_MODE_SEC=120
CHANNEL_CALL_GAP=90
# 去掉表情標點後 ≤ 2 字的訊息不判斷；同字元連續 10 次、同一人被 @ 3 次的訊息不回也不進對話紀錄
NOISE_MAX_CHARS=2
FLOOD_REPEAT_CHARS=10
FLOOD_REPEAT_MENTIONS=3

# ---- 插話判斷（開發規格 6.1）----
# 0 = 只有被叫才回；1 = 門檻 0.7、同頻道每 10 分鐘最多主動插話 1 次；2 = 0.6、5 分鐘；3 = 0.5、2 分鐘
CHIME_IN=1
# 哪些伺服器開插話判斷（逗號分隔）；留空＝只有 TEST_GUILD_IDS
CHIME_GUILD_IDS=
# 留空 = 依 CHIME_IN 的等級；填 0~1 的數字會蓋過等級的門檻（D-22：這是「開口機率」的門檻；舊名 CHIME_THRESHOLD 也認）
CHIME_PROB_THRESHOLD=
# 同頻道最後一則訊息後幾秒沒人再講，才判斷最新那則
CHIME_DEBOUNCE_SEC=4
CHIME_CONTEXT_LINES=15
CHIME_MAX_IMAGES=3
CHIME_MAX_TOKENS=160
# D-29 兩段式：1 = 最新一則提到她（名字、別名、@、回覆她、機器人／AI、她剛講完的他／她／它）才先思考再判斷。
# 實測準一點（+2～3 題）但思考一次約 4～5 秒（最久 15 秒）、會佔住 LM Studio，預設關
CHIME_THINK_ON_MENTION=0
CHIME_THINK_MAX_TOKENS=4000
# 被叫「閉嘴」「沒問你」之後，這個頻道幾分鐘內不主動插話
CHIME_MUTE_MINUTES=30
# 按表情：每個頻道每 10 分鐘最多 3 個（跟插話次數分開算）
CHIME_REACT_MAX=3
CHIME_REACT_WINDOW_MIN=10

# 群組表情與貼圖（6.14）：哪些伺服器可以用自己的表情圖鑑；留空＝只有 TEST_GUILD_IDS。
# 圖鑑（data/emoji/<伺服器ID>.json）還要旁邊的 <伺服器ID>.meta.json 寫 {"reviewed": true} 才會用
EMOJI_GUILD_IDS=
# 插話判斷帶群組表情清單（按反應用群組表情）；實測會讓插話判斷變差，預設 0
CHIME_EMOJI_LIST=0
