DISCORD_TOKEN=你的_DISCORD_BOT_TOKEN

# ---- LM Studio ----
LMSTUDIO_BASE_URL=http://127.0.0.1:8001/v1
# 留空 = 自動用 LM Studio 目前載入的第一個聊天模型
LLM_MODEL=
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=180
# MTP / speculative decoding 模型同時收到多個請求會出錯，保持 1
LLM_MAX_CONCURRENCY=1
# 推理模型想太久會很慢：none / low / medium / high，留空不送
# 聊天回覆建議 none：實測 0.3～2 秒、不會出現空白回覆
LLM_REASONING_EFFORT=none
LLM_JSON_REASONING_EFFORT=low

# ---- Embedding / Rerank ----
# local = 本機 sentence-transformers；lmstudio = 呼叫 LM Studio /v1/embeddings
EMBED_BACKEND=local
EMBED_MODEL=BAAI/bge-m3
RERANK_ENABLED=true
# BAAI/bge-reranker-v2-m3（預設）或 Qwen/Qwen3-Reranker-4B。
# 評估中 Qwen3-Reranker-4B（4-bit）沒有比較準（80% 對 82%），又慢又大，所以預設用 bge
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 4bit / 8bit 需要 bitsandbytes；none = 原本精度（Qwen3-Reranker-4B bf16 約 8 GB 顯存）
RERANK_QUANTIZE=none
# Qwen3-Reranker 的任務說明，留空用預設
RERANK_INSTRUCTION=
RERANK_MIN_SCORE=0.05
# auto / cuda / cpu
DEVICE=auto
# embedding / reranker 用 fp16：顯存 5.2GB → 2.9GB，200 題檢索評估結果一樣（Hit@6 80%）
MODEL_HALF=true
# HuggingFace 模型快取位置（bge-m3、bge-reranker 會從這裡載入，不會重新下載）
HF_HOME=F:\LMSTUDIO\huggingface

# ---- 檢索 ----
RETRIEVE_TOP_N=20
RETRIEVE_FINAL_K=6
RRF_K=60
# 問題有時間說法（昨天、上個月…）時，日期吻合的記憶在 rerank 分數上額外加分
TIME_BOOST=0.1
# rerank 用「拿掉時間與『什麼時候』等問法」後的主題打分（問「什麼時候」時答案在日期裡，原句會讓分數全部過低）
RERANK_FOCUS=true
# 指定了人、但全部被 rerank 門檻刷掉時，仍保留分數最高的幾筆（0 = 不保底）
RERANK_FALLBACK=2
# 「最早／第一次／最後一次」類問題看更多候選，結果依日期排序
ORDER_TOP_N=60
DECOMPOSE_WITH_LLM=true
# 用聊天 LLM 補強檢索：
# LLM_RERANK 讓模型帶著日期挑前 N 筆（約 +1 秒）。time = 只在問題有「昨天」「上個月」等時間說法時才重排
#   （評估中只有這類題目變好）；always = 每次都重排；off = 不用
# QUERY_REWRITE 把問題改寫成記憶的寫法（約 +1.5 秒，跟重排一起開沒有再提升，預設關）
QUERY_REWRITE=false
LLM_RERANK=time
LLM_RERANK_TOP=10

# ---- 對話 ----
BOT_NAME=Yuki
WAKE_WORDS=yuki
ATTENTION_TIMEOUT=180
HISTORY_MESSAGES=20
PASSIVE_ENABLED=true
PASSIVE_BATCH=8
PASSIVE_IDLE_SECONDS=90

# ---- 人物檔案（python -m scripts.build_profiles all 產生）----
PROFILE_ENABLED=true
PROFILE_DIR=data/profiles
PROFILE_DB_PATH=data/profiles.db
PROFILE_MAX_PEOPLE=4
PROFILE_PROMPT_CHARS=1500
# 建檔：32k 上下文的模型每段 9000 字左右剛好
PROFILE_SEGMENT_CHARS=9000
PROFILE_MAX_CHARS=2500
# 這顆模型開推理（low）會把 token 全花在思考上、很慢；none 一段約 10～25 秒
PROFILE_REASONING_EFFORT=none
# 人物檔案自動增量更新：所有頻道閒置 N 分鐘、封存區新訊息滿 N 則才跑，有人講話就停
PROFILE_AUTO_UPDATE=true
PROFILE_IDLE_MINUTES=5
PROFILE_MIN_NEW=200

# ---- 上網（自架 SearXNG：docker compose -f searxng/docker-compose.yml up -d）----
WEB_ENABLED=true
SEARXNG_URL=http://127.0.0.1:8888
# 一次回覆最多幾輪工具呼叫；每個工具結果最多給模型看幾個字
WEB_MAX_ROUNDS=3
WEB_RESULT_CHARS=5000

# ---- 啟動補抓：每次上線先補齊上次關機到現在的訊息（封存區 + 記憶）----
CATCHUP_ENABLED=true
# 「公開頻道」= 這個身分組看得到的頻道，跟 archive_fetch --role 一樣；留空 = @everyone
ARCHIVE_ROLE=
# 不收的頻道名稱，逗號分隔
ARCHIVE_EXCLUDE=
# 補抓到的訊息整理成記憶；每個頻道最多整理最近幾則
CATCHUP_MEMORY=true
CATCHUP_MEMORY_MAX=300
CATCHUP_GAP_MINUTES=30

DB_PATH=data/yuki.db
LOG_LEVEL=INFO

# ---- 檢索方式（開發規格 6.4）----
# agentic：Yuki 自己用工具查封存區（不載入 embedding / reranker）；embedding：舊的每句先檢索
RETRIEVAL=agentic
# 語音一次回覆最多幾輪工具呼叫
VOICE_MAX_ROUNDS=1

# ---- 主人：他交代的事比較會照做，但聊天不偏袒他（Discord user ID，逗號分隔）----
OWNER_USER_IDS=

# ---- 測試伺服器（開發規格 6.0）：不封存、不整理記憶，人物檔案和聊天紀錄借主伺服器的 ----
TEST_GUILD_IDS=
PROFILE_FALLBACK_GUILD=

# ---- 語音對話（開發規格 6.0）----
VOICE_ENABLED=false
VOICE_GUILD_IDS=
# 只聽這些 user ID；其他人的聲音直接丟掉
VOICE_LISTEN_USERS=
# 轉出的文字和 Yuki 的回覆貼到這個文字頻道（除錯用，可留空）
VOICE_LOG_CHANNEL=
VOICE_ASR_MODEL=Qwen/Qwen3-ASR-1.7B
VOICE_ASR_HOTWORDS=LoL,ADC,打野,開黑,TTS,ASR,AI,Discord
# edge（線上、免安裝）或 breezy（WSL 裡的 scripts/breezy_server.py）
VOICE_TTS=edge
VOICE_TTS_VOICE=zh-TW-HsiaoChenNeural
VOICE_TTS_URL=http://127.0.0.1:8890
VOICE_SILENCE_MS=900
VOICE_ALONE_LEAVE_SECONDS=120
VOICE_ATTENTION_SECONDS=60

# ---- 維運（開發規格 6.12）：AI 追蹤紀錄寫在 data/logs/ai/；出錯時私訊 OWNER_USER_IDS 的人 ----
TRACE_MAX_DAYS=14
TRACE_MAX_MB=200
# 同一種錯誤幾分鐘內只通知一次、全部加起來每小時最多幾則、LM Studio 健康檢查間隔（秒）
ALERT_DEDUPE_MIN=30
ALERT_MAX_PER_HOUR=10
ALERT_HEALTH_SEC=60
